generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  telegram  String?
  service   String
  budget    String
  comment   String?
  status    String   @default("Новая")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}
